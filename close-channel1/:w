package main

import (
	"fmt"
	"time"
)

func main() {
	ch := make(chan int)

	go func() {
		for i := 1; i <= 5; i++ {
			ch <- i
			time.Sleep(300 * time.Miliseconds)
		}
		close(ch)
	}()

	for valor := range ch {
		fmt.Println("Recibi: ", valor)
	}

	fmt.Println("Canal cerrado. Fin del programa.")
}
